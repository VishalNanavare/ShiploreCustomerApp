# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android/Gradle local caches and generated artifacts
android/.gradle/
android/.kotlin/
android/local.properties
*.hprof
*.aab
*.apk
output-metadata.json
captures/
.externalNativeBuild/
.cxx/

# CocoaPods — regenerated via `pod install` from Podfile.lock
ios/Pods/

# Release signing — never commit; keystore + credentials stay local/CI-secret only.
*.jks
*.keystore
*.der
google-services.json
key.properties
android/key.properties

# Firebase config — never commit; inject via CI secrets.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Dart obfuscation symbol maps — large binary, kept in CI artifact storage.
build/symbols/
